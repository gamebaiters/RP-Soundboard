/* GameBaiters Soundboard - dark theme stylesheet
 *
 * EVERY rule is scoped under [isGBSoundboard="true"] so the stylesheet
 * can be applied on qApp without leaking into the host TeamSpeak
 * client. Top-level soundboard windows set this dynamic property in
 * their constructor; the descendant selector then matches all child
 * widgets without each child having to set the property too.
 */

/* Top-level soundboard windows + their descendants */
QWidget[isGBSoundboard="true"],
QWidget[isGBSoundboard="true"] QWidget {
    background-color: #2b2b2b;
    color: #dcdcdc;
    selection-background-color: #5a5a5a;
    selection-color: #ffffff;
}

QWidget[isGBSoundboard="true"] QDialog,
QWidget[isGBSoundboard="true"] QMainWindow,
QWidget[isGBSoundboard="true"] QFrame,
QWidget[isGBSoundboard="true"] QGroupBox {
    background-color: #2b2b2b;
}

QWidget[isGBSoundboard="true"] QLineEdit,
QWidget[isGBSoundboard="true"] QTextEdit,
QWidget[isGBSoundboard="true"] QPlainTextEdit,
QWidget[isGBSoundboard="true"] QSpinBox,
QWidget[isGBSoundboard="true"] QDoubleSpinBox,
QWidget[isGBSoundboard="true"] QComboBox {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 2px 4px;
    selection-background-color: #4a90e2;
}

QWidget[isGBSoundboard="true"] QLineEdit {
    placeholder-text-color: #6a6a6a;
}

QWidget[isGBSoundboard="true"] QLineEdit:focus,
QWidget[isGBSoundboard="true"] QTextEdit:focus,
QWidget[isGBSoundboard="true"] QPlainTextEdit:focus,
QWidget[isGBSoundboard="true"] QSpinBox:focus,
QWidget[isGBSoundboard="true"] QDoubleSpinBox:focus,
QWidget[isGBSoundboard="true"] QComboBox:focus {
    border: 1px solid #4a90e2;
}

QWidget[isGBSoundboard="true"] QComboBox::drop-down {
    border-left: 1px solid #555555;
    width: 18px;
}

QWidget[isGBSoundboard="true"] QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #dcdcdc;
    selection-background-color: #4a90e2;
    border: 1px solid #555555;
}

QWidget[isGBSoundboard="true"] QPushButton {
    background-color: #3a3a3a;
    color: #dcdcdc;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 4px 10px;
    min-height: 18px;
}

QWidget[isGBSoundboard="true"] QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #6a6a6a;
}

QWidget[isGBSoundboard="true"] QPushButton:pressed {
    background-color: #1f1f1f;
}

QWidget[isGBSoundboard="true"] QPushButton:checked {
    background-color: #4a90e2;
    color: #ffffff;
    border-color: #3a78c2;
}

QWidget[isGBSoundboard="true"] QPushButton:disabled {
    background-color: #2a2a2a;
    color: #6a6a6a;
    border-color: #3a3a3a;
}

QWidget[isGBSoundboard="true"] QCheckBox,
QWidget[isGBSoundboard="true"] QRadioButton {
    color: #dcdcdc;
    spacing: 6px;
    background: transparent;
}

QWidget[isGBSoundboard="true"] QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #1e1e1e;
    border: 1px solid #777777;
    border-radius: 7px;
}

QWidget[isGBSoundboard="true"] QRadioButton::indicator:checked {
    background-color: #4a90e2;
    border: 1px solid #4a90e2;
}

QWidget[isGBSoundboard="true"] QRadioButton::indicator:hover {
    border: 1px solid #6ab0ff;
}

QWidget[isGBSoundboard="true"] QSlider::groove:horizontal {
    background: #1e1e1e;
    height: 6px;
    border-radius: 3px;
}

QWidget[isGBSoundboard="true"] QSlider::handle:horizontal {
    background: #888888;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    border: 1px solid #555555;
}

QWidget[isGBSoundboard="true"] QSlider::handle:horizontal:hover {
    background: #4a90e2;
}

QWidget[isGBSoundboard="true"] QSlider::sub-page:horizontal {
    background: #4a90e2;
    border-radius: 3px;
}

QWidget[isGBSoundboard="true"] QSlider::groove:vertical {
    background: #1e1e1e;
    width: 6px;
    border-radius: 3px;
}

QWidget[isGBSoundboard="true"] QSlider::handle:vertical {
    background: #888888;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
    border: 1px solid #555555;
}

QWidget[isGBSoundboard="true"] QSlider::handle:vertical:hover {
    background: #4a90e2;
}

QWidget[isGBSoundboard="true"] QSlider:disabled {
    color: #555555;
}

QWidget[isGBSoundboard="true"] QSlider::groove:horizontal:disabled,
QWidget[isGBSoundboard="true"] QSlider::groove:vertical:disabled {
    background: #1a1a1a;
}

QWidget[isGBSoundboard="true"] QSlider::sub-page:horizontal:disabled,
QWidget[isGBSoundboard="true"] QSlider::sub-page:vertical:disabled {
    background: #3a3a3a;
}

QWidget[isGBSoundboard="true"] QSlider::handle:horizontal:disabled,
QWidget[isGBSoundboard="true"] QSlider::handle:vertical:disabled {
    background: #4a4a4a;
    border-color: #3a3a3a;
}

QWidget[isGBSoundboard="true"] QLabel:disabled,
QWidget[isGBSoundboard="true"] QCheckBox:disabled,
QWidget[isGBSoundboard="true"] QRadioButton:disabled,
QWidget[isGBSoundboard="true"] QSpinBox:disabled,
QWidget[isGBSoundboard="true"] QDoubleSpinBox:disabled,
QWidget[isGBSoundboard="true"] QComboBox:disabled,
QWidget[isGBSoundboard="true"] QLineEdit:disabled {
    color: #6a6a6a;
}

QWidget[isGBSoundboard="true"] QSpinBox:disabled,
QWidget[isGBSoundboard="true"] QDoubleSpinBox:disabled,
QWidget[isGBSoundboard="true"] QComboBox:disabled,
QWidget[isGBSoundboard="true"] QLineEdit:disabled {
    background-color: #161616;
    border-color: #2e2e2e;
}

QWidget[isGBSoundboard="true"] QGroupBox {
    border: 1px solid #555555;
    border-radius: 3px;
    margin-top: 22px;
    padding-top: 10px;
}

QWidget[isGBSoundboard="true"] QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 4px;
    padding: 0 4px;
    color: #dcdcdc;
}

QWidget[isGBSoundboard="true"] QGroupBox::indicator {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    top: 4px;
}

QWidget[isGBSoundboard="true"] QScrollBar:vertical {
    background: #2b2b2b;
    width: 12px;
    border: none;
}

QWidget[isGBSoundboard="true"] QScrollBar::handle:vertical {
    background: #555555;
    min-height: 20px;
    border-radius: 6px;
}

QWidget[isGBSoundboard="true"] QScrollBar::handle:vertical:hover {
    background: #6a6a6a;
}

QWidget[isGBSoundboard="true"] QScrollBar:horizontal {
    background: #2b2b2b;
    height: 12px;
    border: none;
}

QWidget[isGBSoundboard="true"] QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 20px;
    border-radius: 6px;
}

QWidget[isGBSoundboard="true"] QScrollBar::handle:horizontal:hover {
    background: #6a6a6a;
}

QWidget[isGBSoundboard="true"] QScrollBar::add-line,
QWidget[isGBSoundboard="true"] QScrollBar::sub-line {
    background: none;
    border: none;
}

QWidget[isGBSoundboard="true"] QMenu {
    background-color: #2b2b2b;
    color: #dcdcdc;
    border: 1px solid #555555;
}

QWidget[isGBSoundboard="true"] QMenu::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QWidget[isGBSoundboard="true"] QMenu::separator {
    height: 1px;
    background: #555555;
    margin: 4px 6px;
}

QWidget[isGBSoundboard="true"] QToolTip {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #555555;
    padding: 2px;
}

QWidget[isGBSoundboard="true"] QLabel {
    background: transparent;
    color: #dcdcdc;
}

QWidget[isGBSoundboard="true"] QListView,
QWidget[isGBSoundboard="true"] QTreeView,
QWidget[isGBSoundboard="true"] QTableView {
    background-color: #1e1e1e;
    color: #dcdcdc;
    border: 1px solid #555555;
    selection-background-color: #4a90e2;
    selection-color: #ffffff;
    alternate-background-color: #252525;
}

QWidget[isGBSoundboard="true"] QSplitter::handle {
    background: #555555;
}

QWidget[isGBSoundboard="true"] QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
}

QWidget[isGBSoundboard="true"] QToolButton:hover {
    background-color: #4a4a4a;
    border-color: #555555;
}

QWidget[isGBSoundboard="true"] QToolButton:pressed {
    background-color: #1f1f1f;
}

/* Bottom-bar gear button: full QPushButton-like styling so it follows
   the theme like the rest of the buttons instead of looking flat. */
QWidget[isGBSoundboard="true"] QToolButton#settingsButton {
    background-color: #3a3a3a;
    color: #dcdcdc;
    border: 1px solid #555555;
    border-radius: 5px;
    padding: 4px 12px;
}

QWidget[isGBSoundboard="true"] QToolButton#settingsButton:hover {
    background-color: #4a4a4a;
    border-color: #777777;
}

QWidget[isGBSoundboard="true"] QToolButton#settingsButton:pressed {
    background-color: #1f1f1f;
}

/* ================= HOST-THEME ISOLATION HARDENING =================
   The TS3 client theme lives on qApp and cascades into our windows.
   These windows carry this sheet as a WIDGET stylesheet (wins over the
   app sheet on conflicts), so every property a host theme is known to
   mangle is pinned down explicitly here: fonts (OLED themes force
   9pt/500), checkbox "iOS switch" indicators, slider page fills. */

/* Font: NOT declared here. Theme::fontStyleSheet() generates the rule
   at runtime from the SYSTEM UI font (family + point size), so the
   soundboard always matches the desktop's own text size and follows
   DPI scaling - a hardcoded px size rendered everything microscopic on
   scaled displays. The generated rule still overrides whatever the
   host theme tries to impose. */

QWidget[isGBSoundboard="true"] QCheckBox::indicator,
QWidget[isGBSoundboard="true"] QGroupBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #777777;
    border-radius: 3px;
    background-color: #1e1e1e;
    image: none;
}
QWidget[isGBSoundboard="true"] QCheckBox::indicator:hover,
QWidget[isGBSoundboard="true"] QGroupBox::indicator:hover {
    border-color: #4a90e2;
}
QWidget[isGBSoundboard="true"] QCheckBox::indicator:checked,
QWidget[isGBSoundboard="true"] QGroupBox::indicator:checked {
    background-color: #4a90e2;
    border-color: #6ab0ff;
    image: url(:/icon/img/check_14.png);
}
QWidget[isGBSoundboard="true"] QCheckBox::indicator:disabled,
QWidget[isGBSoundboard="true"] QGroupBox::indicator:disabled {
    background-color: #2a2a2a;
    border-color: #2e2e2e;
}

/* SLIDERS - pin EVERY layout property. Qt merges non-conflicting
   properties across app+widget sheets, so anything we leave unset
   leaks in from the host theme. The concrete bug: the TS3 dark theme
   sets "padding-left/right: 5px" + an accent background on the groove;
   those 5px of padding survived the merge and a slider at ZERO still
   showed a 5px filled stub. Everything pinned = nothing to leak. */
QWidget[isGBSoundboard="true"] QSlider {
    background: transparent;
    border: none;
}
QWidget[isGBSoundboard="true"] QSlider::groove:horizontal,
QWidget[isGBSoundboard="true"] QSlider::groove:vertical {
    border: none;
    border-image: none;
    padding: 0px;
    margin: 0px;
}
QWidget[isGBSoundboard="true"] QSlider::handle:horizontal,
QWidget[isGBSoundboard="true"] QSlider::handle:vertical {
    border-image: none;
    padding: 0px;
}
QWidget[isGBSoundboard="true"] QSlider::sub-page:horizontal,
QWidget[isGBSoundboard="true"] QSlider::sub-page:vertical {
    border: none;
    border-image: none;
    padding: 0px;
    margin: 0px;
}
QWidget[isGBSoundboard="true"] QSlider::sub-page:vertical {
    background: #4a90e2;
    border-radius: 3px;
}

/* BIPOLAR sliders (pitch / speed / mic gain: minimum < 0, zero in the
   MIDDLE). Qt always paints sub-page from the left edge to the centre
   of the handle, so a bipolar slider sitting at 0 looked "half full"
   even though it is neutral. Sliders tagged sliderPolarity="bipolar"
   (set automatically for any slider whose minimum is negative) drop
   the accent fill entirely - the handle position alone tells the
   value, exactly like a pan pot. */
QWidget[isGBSoundboard="true"] QSlider[sliderPolarity="bipolar"]::sub-page:horizontal,
QWidget[isGBSoundboard="true"] QSlider[sliderPolarity="bipolar"]::sub-page:vertical {
    background: #1e1e1e;
    border: none;
    border-image: none;
    border-radius: 2px;
    padding: 0px;
    margin: 0px;
}
QWidget[isGBSoundboard="true"] QSlider::add-page:horizontal,
QWidget[isGBSoundboard="true"] QSlider::add-page:vertical {
    background: #1e1e1e;
    border: none;
    border-image: none;
    border-radius: 2px;
    padding: 0px;
    margin: 0px;
}

/* Host QSplitter styling must not thicken/paint our grid divider. */
QWidget[isGBSoundboard="true"] QSplitter::handle {
    image: none;
}

/* Universal shield: many popular TS3 themes (DarkenTS & co.) skin
   widgets via border-image. The soundboard never uses border-image,
   so blanket-reset it on our whole subtree - whatever theme the host
   runs, its picture-frames can't bleed into our controls. */
QWidget[isGBSoundboard="true"] * {
    border-image: none;
}

/* Button borders: host themes colour :checked / :hover states (green
   "active", red "recording" and friends). Those leaked onto our mic-FX
   toggle and the settings button. Pin the border for the generic
   button states; the soundboard's own variants (macro / special /
   syncRole / profileRole) use more specific selectors and still win. */
QWidget[isGBSoundboard="true"] QPushButton:checked,
QWidget[isGBSoundboard="true"] QToolButton:checked {
    border: 1px solid #4a90e2;
    background-color: #3a5a7a;
    color: #ffffff;
}
QWidget[isGBSoundboard="true"] QPushButton:hover,
QWidget[isGBSoundboard="true"] QToolButton:hover {
    border: 1px solid #777777;
}
QWidget[isGBSoundboard="true"] QPushButton:checked:hover,
QWidget[isGBSoundboard="true"] QToolButton:checked:hover {
    border: 1px solid #6ab0ff;
}
QWidget[isGBSoundboard="true"] QPushButton:pressed,
QWidget[isGBSoundboard="true"] QToolButton:pressed {
    border: 1px solid #555555;
}
QWidget[isGBSoundboard="true"] QToolButton {
    border: 1px solid transparent;
    background-color: transparent;
}
